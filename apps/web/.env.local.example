# ============================================
# Frontend Environment Variables
# ============================================
# Copy this file to .env.local and fill in actual values
# NEVER commit .env.local to version control

# ============================================
# API Configuration
# ============================================
# Base URL for the NestJS backend API
# During local development, this should point to http://localhost:3001
# In production, set this to your deployed API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# Setup Instructions
# ============================================
# 1. Copy this file: cp .env.local.example .env.local
# 2. Verify NEXT_PUBLIC_API_URL matches your API server port
# 3. Start the frontend: pnpm --filter web dev
#
# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Never include secrets in NEXT_PUBLIC_ variables
