# ============================================
# Environment Configuration
# ============================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

# ============================================
# Node.js Requirements
# ============================================
# This project requires Node.js 20.9+ (Node.js 18 is EOL)
# Verify with: node --version

# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# Database - Choose ONE option below
# ============================================

# Option 1: Local Docker Compose PostgreSQL
# Start with: pnpm db:up
# Stop with: pnpm db:down
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/easyreachout?schema=public"

# Option 2: Supabase PostgreSQL (with connection pooling)
# Get this from: Supabase Dashboard > Project Settings > Database > Connection String (URI)
# Use the pooled connection (port 6543) for application runtime:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# For Prisma migrations on Supabase, use direct connection:
# Get from: Database > Connection String > URI (Direct connection)
# Use the direct connection (port 5432) for migrations:
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ============================================
# Security
# ============================================
# JWT_SECRET: Used for signing authentication tokens
# MUST be at least 32 characters long
# Generate a secure random secret with:
#   openssl rand -base64 32
#
# Example output: Xy9vK2mN8pQ4rS6tU7wV0xY1zA3bC5dE6fG8hI0jK2l=
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-replace-this

# ============================================
# Setup Instructions
# ============================================
# 1. Copy this file to apps/api/.env
#    cp .env.example apps/api/.env
# 2. Generate JWT_SECRET: openssl rand -base64 32
# 3. Choose database option (Docker Compose or Supabase)
# 4. Start database: pnpm db:up (if using Docker)
# 5. Run migrations: pnpm db:migrate
# 6. Start development servers: pnpm dev
#
# Note: Prisma needs the .env file in apps/api/ directory
